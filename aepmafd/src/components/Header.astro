---
const links = [
  { href: "/", label: "Inicio" },
  { href: "/conocenos", label: "Conócenos" },
  { href: "/objetivos", label: "Objetivos" },
  { href: "/actividades", label: "Actividades" },
  { href: "/estructura", label: "Estructura" },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-neutral-200 bg-white">
  <div
    class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6"
  >
    <a href="/" class="flex items-center gap-3">
      <img
        src="/logo-aepmafd.svg"
        alt="Logo AEPMAFD"
        class="h-12 w-auto sm:h-14"
      />
      <div class="hidden md:block">
        <p class="text-sm font-semibold leading-tight text-slate-800">
          Asociación Española de Psicopedagogía
        </p>
        <p class="text-sm leading-tight text-slate-600">
          de la Motricidad, la Actividad Física y el Deporte
        </p>
      </div>
    </a>

    <nav class="hidden md:block">
      <ul class="flex items-center gap-6">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "text-sl font-medium transition hover:text-primary",
                  currentPath === link.href ? "text-primary" : "text-secondary",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      id="menu-toggle"
      class="rounded-md border border-neutral-300 px-4 py-2 text-sm text-slate-800 md:hidden"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
      type="button"
    >
      Menú
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-neutral-200 bg-white md:hidden"
  >
    <nav class="mx-auto max-w-7xl px-4 py-3 sm:px-6">
      <ul class="flex flex-col gap-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "block rounded-md px-3 py-2 text-sm font-medium transition hover:bg-neutral-100",
                  currentPath === link.href
                    ? "bg-neutral-100 text-primary"
                    : "text-secondary",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const toggleButton = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");

    if (!toggleButton || !mobileMenu) return;
    if (toggleButton.dataset.menuBound === "true") return;

    toggleButton.dataset.menuBound = "true";

    toggleButton.addEventListener("click", () => {
      const isHidden = mobileMenu.classList.contains("hidden");
      mobileMenu.classList.toggle("hidden");
      toggleButton.setAttribute("aria-expanded", isHidden ? "true" : "false");
    });
  }

  setupMobileMenu();
  document.addEventListener("astro:page-load", setupMobileMenu);
</script>
