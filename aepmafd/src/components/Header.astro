---
const links = [
  { href: "/", label: "Inicio" },
  { href: "/conocenos", label: "Conócenos" },
  { href: "/objetivos", label: "Objetivos" },
  { href: "/actividades", label: "Actividades" },
  { href: "/estructura", label: "Estructura" },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-neutral-200 bg-white">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-3">
      <img src="/logo-aepmafd.svg" alt="Logo AEPMAFD" class="h-14 w-auto" />
      <div class="hidden md:block">
        <p class="text-sm font-semibold leading-tight text-slate-800">
          Asociación Española de Psicopedagogía
        </p>
        <p class="text-sm leading-tight text-slate-600">
          de la Motricidad, la Actividad Física y el Deporte
        </p>
      </div>
    </a>

    <nav class="hidden md:block">
      <ul class="flex items-center gap-6">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "text-sl font-medium transition hover:text-primary",
                  currentPath === link.href ? "text-primary" : "text-secondary",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      class="rounded-md border border-neutral-300 px-4 py-2 text-sm md:hidden"
      aria-label="Abrir menú"
    >
      Menú
    </button>
  </div>
</header>
