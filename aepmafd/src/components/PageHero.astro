---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section
  class="hero-banner bg-cover bg-center relative isolate overflow-hidden max-h-31.25 md:h-80"
>
  <div class="absolute inset-0 bg-black/45"></div>

  <div class="absolute inset-0 flex items-center">
    <div class="mx-auto w-full max-w-8xl px-6">
      <h1
        class="w-full h-full flex justify-center text-white font-bold small-caps tracking-tight md:text-[30px]"
      >
        {title}
      </h1>
      {
        subtitle && (
          <p class="mt-4 max-w-2xl text-base text-white/90 md:text-lg">
            {subtitle}
          </p>
        )
      }
    </div>
  </div>
</section>
