---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section
  class="hero-banner bg-cover bg-center relative isolate overflow-hidden"
>
  <div class="absolute inset-0 bg-black/45"></div>

  <div
    class="relative mx-auto flex min-h-[90px] w-full max-w-8xl items-center justify-center px-4 py-6 sm:min-h-[110px] md:min-h-[180px] md:px-6"
  >
    <div class="w-full text-center">
      <h1
        class="text-2xl text-white font-bold small-caps tracking-tight sm:text-3xl md:text-[30px]"
      >
        {title}
      </h1>
      {
        subtitle && (
          <p class="mx-auto mt-3 max-w-2xl text-sm text-white/90 sm:text-base md:text-lg">
            {subtitle}
          </p>
        )
      }
    </div>
  </div>
</section>
