---
import PageHero from "@components/PageHero.astro";

import Layout from "@layouts/Layout.astro";
---

<Layout>
  <PageHero title="Estructura" />
  <section class="mx-auto max-w-6xl px-6 py-10">
    <h2 class="py-2 mb-2 text-2xl font-semibold text-secondary md:text-3xl">
      OBJETIVOS GENERALES:
    </h2>
    <h3 class="my-2 text-lg font-semibold md:text-xl">Presidenta</h3>
    <ul class="list-disc pl-5">
      <li
        class="text-[15px] py-1 leading-6 tracking-tight text-justify text-neutral-950"
      >
        Concepción Suárez Llorca
      </li>
    </ul>
    <h3 class="my-2 text-lg font-semibold md:text-xl">
      Vicepresidente y secretario
    </h3>
    <ul class="list-disc pl-5">
      <li
        class="text-[15px] py-1 leading-6 tracking-tight text-justify text-neutral-950"
      >
        José Antonio Pérez Turpin
      </li>
    </ul>
    <h3 class="my-2 text-lg font-semibold md:text-xl">Coordinadoras</h3>
    <ul class="list-disc pl-5">
      <li
        class="text-[15px] py-1 leading-6 tracking-tight text-justify text-neutral-950"
      >
        María José Gomis Gomis
      </li>
      <li
        class="text-[15px] py-1 leading-6 tracking-tight text-justify text-neutral-950"
      >
        Arantxa Fuentes Suárez
      </li>
    </ul>
  </section>
</Layout>
