---
import PageHero from "@components/PageHero.astro";
import Content from "@components/Content.astro";

import Layout from "@layouts/Layout.astro";
import imgActividades from "@assets/actividades.webp";

import { Image } from "astro:assets";
---

<Layout
  title="Actividades | AEPMAFD"
  description="Consulta las principales actividades de la AEPMAFD: congresos, mesas redondas, investigación, acreditación profesional, divulgación y programas formativos vinculados a la motricidad y la actividad física."
>
  <PageHero title="Actividades" />
  <Content>
    <Fragment slot="title">
      <h2 class="py-2 text-2xl font-semibold text-secondary md:text-3xl">
        ACTIVIDADES PRINCIPALES:
      </h2>
    </Fragment>
    <Fragment slot="left">
      <ul class="list-disc pl-5">
        <li
          class="text-[15px] py-3 leading-6 tracking-tight text-justify text-neutral-950"
        >
          Organizar simposios, conferencia y mesas redondas
        </li>
        <li
          class="text-[15px] py-3 leading-6 tracking-tight text-justify text-neutral-950"
        >
          Apoyar y fomentar la investigación en Psicopedagogía de la Motricidad,
          la Actividad Física y el Deporte
        </li>
        <li
          class="text-[15px] py-3 leading-6 tracking-tight text-justify text-neutral-950"
        >
          Crear un sistema de Acreditación que facilite la profesionalización
          del sector
        </li>
        <li
          class="text-[15px] py-3 leading-6 tracking-tight text-justify text-neutral-950"
        >
          Facilitar la relación entre entidades nacionales e internacionales
        </li>
        <li
          class="text-[15px] py-3 leading-6 tracking-tight text-justify text-neutral-950"
        >
          Divulgar y difundir los conocimientos del ámbito en la sociedad
        </li>
        <li
          class="text-[15px] py-3 leading-6 tracking-tight text-justify text-neutral-950"
        >
          Promover y garantizar un desarrollo profesional de esta área
        </li>
      </ul>
    </Fragment>
    <Fragment slot="right">
      <Image
        src={imgActividades}
        alt="Imagen representativa de las actividades de la AEPMAFD"
        class="w-full h-full object-cover rounded-xl max-w-87.5"
      />
    </Fragment>
  </Content>
</Layout>
