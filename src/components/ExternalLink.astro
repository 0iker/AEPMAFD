---
interface Props {
  href: string;
  class?: string;
}

import ExternalLinkIcon from "@icons/ExternalLink.astro";

const { href, class: className = "" } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "inline-flex items-center gap-1 font-medium text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2",
    className,
  ]}
>
  <slot />
  <ExternalLinkIcon />
  <span class="sr-only">(se abre en otra web, en una pestaña nueva)</span>
</a>
