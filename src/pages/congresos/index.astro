---
import PageHero from "@components/PageHero.astro";

import Layout from "@layouts/Layout.astro";

interface Congreso {
  href: string;
  titulo: string;
  fechas: string;
  modalidad: string;
  descripcion: string;
  estado: string;
}

const congresos: Congreso[] = [
  {
    href: "/congresos/i-congreso-2026",
    titulo: "I Congreso AEPMAFD 2026",
    fechas: "18 y 19 de junio de 2026",
    modalidad: "Online",
    descripcion: "Organizado junto al Consejo Superior de Deportes.",
    estado: "Celebrado",
  },
];
---

<Layout
  title="Congresos | AEPMAFD"
  description="Congresos científicos de la AEPMAFD: espacio de encuentro entre docentes, entrenadores, investigadores y estudiantes de la motricidad, la actividad física y el deporte."
>
  <PageHero title="Congresos" />

  <section class="mx-auto max-w-6xl px-6 py-10">
    <p class="text-lg leading-8 text-justify text-neutral-950">
      La AEPMAFD organiza congresos científicos como espacio de encuentro entre
      docentes, entrenadores, investigadores y estudiantes vinculados a la
      motricidad, la actividad física y el deporte.
    </p>

    <ul class="mt-10 grid gap-8 md:grid-cols-2">
      {
        congresos.map((congreso) => (
          <li>
            <article class="flex h-full flex-col rounded-2xl border border-neutral-200 bg-white p-8 shadow-sm">
              <div class="flex items-start justify-between gap-3">
                <h2 class="text-2xl font-semibold text-secondary md:text-3xl">
                  {congreso.titulo}
                </h2>
                <span class="shrink-0 rounded-full bg-neutral-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-secondary">
                  {congreso.estado}
                </span>
              </div>

              <p class="mt-3 text-[15px] font-medium text-neutral-700">
                {congreso.fechas} · {congreso.modalidad}
              </p>
              <p class="mt-2 text-[15px] leading-6 text-neutral-950">
                {congreso.descripcion}
              </p>

              <a
                href={congreso.href}
                class="mt-6 inline-block font-medium text-primary hover:underline"
              >
                Ver el congreso →
              </a>
            </article>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
